# CRM-Pro på Vercel + Neon Postgres.
# På Vercel sættes DATABASE_URL og DATABASE_URL_UNPOOLED automatisk, når Neon
# kobles på projektet under Storage. Lokalt: hent dem med `vercel env pull .env`.

# Poolet forbindelse — den appen bruger
DATABASE_URL="postgresql://bruger:kode@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Direkte forbindelse — bruges til skemaændringer (prisma db push) og flyttescriptet
DATABASE_URL_UNPOOLED="postgresql://bruger:kode@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Nøgle der signerer login-cookien. Mindst 32 tegn. Lav en med:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Kun nødvendig hvis databasen er tom og den første bruger skal oprettes på
# internettet. Mindst 8 tegn. Kan fjernes igen bagefter.
OPSAETNINGSKODE=""
